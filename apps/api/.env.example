# App
APP_ENV=local
LOG_LEVEL=INFO

# Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Database
# Pooled connection for the app (Neon -pooler endpoint or local equivalent)
DATABASE_URL=postgresql+psycopg://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct connection for Alembic migrations (no -pooler in hostname)
DATABASE_URL_DIRECT=postgresql+psycopg://user:pass@host.region.aws.neon.tech/dbname?sslmode=require

# R2 / object storage (Phase 4)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=outlay-contracts

# Anthropic (Phase 8)
ANTHROPIC_API_KEY=